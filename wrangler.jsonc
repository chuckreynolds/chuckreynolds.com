{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crus",
  "compatibility_date": "2026-07-22",
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist/",
    "binding": "ASSETS",
    // Only the negotiated path pays for a Worker invocation; every other asset
    // is served directly from the edge.
    "run_worker_first": ["/", "/index.html"],
    // Static site: unknown paths must 404, not fall back to index.html.
    // "single-page-application" would serve index.html with a 200 for every
    // miss, which Google treats as a soft 404.
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
